<mxCell id="apps_frame" value="&lt;b&gt;Django apps&lt;/b&gt; – each app follows the same layering: urls → views (APIView) → serializers → services (where present) → models. Counts: REST routes / tables." style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1300" height="560" as="geometry"></mxGeometry></mxCell>
<mxCell id="app_users" value='&lt;b&gt;users&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;38 routes · 20 tables&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Accounts, profiles, roles, permissions, staff groups, OTP, external identities&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#555555"&gt;&lt;i&gt;views · serializers · services · tasks&lt;/i&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="apps_frame"><mxGeometry x="20" y="50" width="300" height="145" as="geometry"></mxGeometry></mxCell>
<mxCell id="app_institution" value='&lt;b&gt;institution&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;34 routes · 16 tables&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Tenants, branches, departments, working days, bank/KYC data, ownership transfer&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#555555"&gt;&lt;i&gt;views · serializers · services · tasks&lt;/i&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="apps_frame"><mxGeometry x="340" y="50" width="300" height="145" as="geometry"></mxGeometry></mxCell>
<mxCell id="app_projects" value='&lt;b&gt;projects&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;38 routes · 19 tables&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Projects, project tasks, statuses, discussions, timesheets, extension requests&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#555555"&gt;&lt;i&gt;views · serializers · services · task&lt;/i&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="apps_frame"><mxGeometry x="660" y="50" width="300" height="145" as="geometry"></mxGeometry></mxCell>
<mxCell id="app_tasks" value='&lt;b&gt;tasks&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;27 routes · 16 tables&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Standalone tasks, task groups, statuses, discussions, extension requests&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#555555"&gt;&lt;i&gt;views · serializers · services · task&lt;/i&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="apps_frame"><mxGeometry x="980" y="50" width="300" height="145" as="geometry"></mxGeometry></mxCell>
<mxCell id="app_performance" value='&lt;b&gt;performance&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;158 routes · 117 tables&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;KPIs, assignments, results, performance reports, PIPs, attention rules, appraisal forms, loyalty&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#555555"&gt;&lt;i&gt;views · serializers · services · tasks · utils · mixins&lt;/i&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="apps_frame"><mxGeometry x="20" y="215" width="300" height="145" as="geometry"></mxGeometry></mxCell>
<mxCell id="app_approval" value='&lt;b&gt;approval&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;19 routes · 11 tables&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Maker-checker engine: documents, levels, approver groups, approvals, approval tasks&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#555555"&gt;&lt;i&gt;views · serializers · tasks · BaseApprovableModel&lt;/i&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="apps_frame"><mxGeometry x="340" y="215" width="300" height="145" as="geometry"></mxGeometry></mxCell>
<mxCell id="app_calendar2" value='&lt;b&gt;calendar2&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;5 routes · 7 tables&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Calendars, events, occurrences, public holidays&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#555555"&gt;&lt;i&gt;views · serializers&lt;/i&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=6;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="apps_frame"><mxGeometry x="660" y="215" width="300" height="145" as="geometry"></mxGeometry></mxCell>
<mxCell id="app_communication" value='&lt;b&gt;communication&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;9 routes · 4 tables&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Notifications (+SSE), notes, announcements, acknowledgements&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#555555"&gt;&lt;i&gt;views · serializers · notifications&lt;/i&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=6;fillColor=#ffcce6;strokeColor=#cc6699;" vertex="1" parent="apps_frame"><mxGeometry x="980" y="215" width="300" height="145" as="geometry"></mxGeometry></mxCell>
