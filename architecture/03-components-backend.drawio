<mxCell id="cmp_asgi" value='&lt;b&gt;ASGI entry&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[core/asgi.py · Daphne]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;ProtocolTypeRouter – HTTP only&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="220" height="110" as="geometry"></mxGeometry></mxCell>
<mxCell id="cmp_middleware" value='&lt;b&gt;Middleware chain&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[core/settings.py]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Prometheus · CORS · &lt;b&gt;ResourceMiddleware&lt;/b&gt; (X-Resource-UUID for /api/performance) · Security · WhiteNoise · Session · CSRF · Auth · crum (current user/request)&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320" y="150" width="360" height="110" as="geometry"></mxGeometry></mxCell>
<mxCell id="cmp_urls" value="&lt;b&gt;URL router&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[core/urls.py]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/api/&amp;lt;app&amp;gt;/ → each app's urls.py · /admin · /metrics&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="740" y="150" width="240" height="110" as="geometry"></mxGeometry></mxCell>
<mxCell id="cmp_auth" value='&lt;b&gt;Authentication&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[users/authentication.py · system/authentication.py]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;CrossSystemJWTAuthentication → PartnerSystemAuthentication (X-API-Key) or SimpleJWT. Attaches request.institution.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1040" y="150" width="300" height="110" as="geometry"></mxGeometry></mxCell>
<mxCell id="cmp_perm" value='&lt;b&gt;Authorisation&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[utilities/permissions.py]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;IsAuthenticated (default) · MethodPermissionMixin · InstitutionPermission.require → CustomUser.has_permission&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1040" y="300" width="300" height="110" as="geometry"></mxGeometry></mxCell>
