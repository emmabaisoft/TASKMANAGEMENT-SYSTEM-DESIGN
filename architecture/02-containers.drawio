<mxCell id="c_beat_db" value="schedule tables" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#444444;dashed=1;exitX=0.5;exitY=0;entryX=0;entryY=0.85;" edge="1" parent="1" source="con_beat" target="con_db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c_redis_worker" value="deliver tasks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#444444;" edge="1" parent="1" source="con_redis" target="con_worker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
