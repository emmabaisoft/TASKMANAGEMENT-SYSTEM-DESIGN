<mxCell id="actor_user" value='&lt;b&gt;Institution user&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Browser&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="200" height="90" as="geometry"></mxGeometry></mxCell>
<mxCell id="actor_operator" value='&lt;b&gt;Platform operator&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Browser&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="200" height="90" as="geometry"></mxGeometry></mxCell>
<mxCell id="ext_partner" value='&lt;b&gt;Partner / host platform&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Hosts the frontend module and calls the API server-to-server.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#e6e6e6;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="200" height="130" as="geometry"></mxGeometry></mxCell>
<mxCell id="boundary" value="&lt;b&gt;Task &amp;amp; Performance Management&lt;/b&gt; [system boundary]" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#1168bd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#1168bd;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="1040" height="760" as="geometry"></mxGeometry></mxCell>
<mxCell id="con_frontend" value='&lt;b&gt;Frontend module “taskmgt”&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Next.js 15 · React 19 · TypeScript]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Mounted in the host platform at /apps/taskmgt. Redux Toolkit, React Query, axios. Own Docker image (node:22-alpine).&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="boundary"><mxGeometry x="40" y="70" width="280" height="150" as="geometry"></mxGeometry></mxCell>
<mxCell id="con_api" value='&lt;b&gt;API application&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Django 5.2 · DRF · Daphne (ASGI) :8000]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;REST API under /api/*, Django admin, /metrics, server-sent events for notifications, static files via WhiteNoise, media under /media (DEBUG only). Docker image python:3.10-slim.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="boundary"><mxGeometry x="400" y="70" width="300" height="170" as="geometry"></mxGeometry></mxCell>
<mxCell id="con_worker" value='&lt;b&gt;Celery worker&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Celery 5.5 · same code base]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Runs ~30 tasks: KPI processing, progress evaluation, e-mails, PDF report generation, partner callbacks, permission sync. Default queue: productivity_queue.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="boundary"><mxGeometry x="400" y="330" width="300" height="150" as="geometry"></mxGeometry></mxCell>
<mxCell id="con_beat" value='&lt;b&gt;Celery beat&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Celery beat · django-celery-beat DatabaseScheduler]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;9 periodic schedules declared in core/celery.py (every minute … weekly).&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="boundary"><mxGeometry x="40" y="330" width="280" height="150" as="geometry"></mxGeometry></mxCell>
<mxCell id="con_db" value='&lt;b&gt;Relational database&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;242 application tables + framework tables (sessions, token blacklist, celery beat, auditlog).&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="boundary"><mxGeometry x="780" y="70" width="220" height="150" as="geometry"></mxGeometry></mxCell>
<mxCell id="con_redis" value='&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Redis]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Celery broker · Channels layer (configured) · notification read-state keys.&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="boundary"><mxGeometry x="780" y="330" width="220" height="150" as="geometry"></mxGeometry></mxCell>
<mxCell id="con_media" value='&lt;b&gt;Media storage&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Local filesystem (MEDIA_ROOT)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Uploaded attachments, signatures and generated report PDFs (FileSystemStorage).&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="boundary"><mxGeometry x="780" y="560" width="220" height="140" as="geometry"></mxGeometry></mxCell>
<mxCell id="con_cache_note" value="&lt;b&gt;Cache:&lt;/b&gt; no CACHES setting exists, so Django's default per-process in-memory cache is used (resource lookup in ResourceMiddleware, partner-system helpers). It is not shared between processes." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fffde7;strokeColor=#bfa900;fontColor=#000000;" vertex="1" parent="boundary"><mxGeometry x="400" y="560" width="300" height="110" as="geometry"></mxGeometry></mxCell>
<mxCell id="con_inferred" value="&lt;b&gt;Inferred – verify&lt;/b&gt;&lt;br&gt;No docker-compose / orchestration config exists. That web and worker share the same MEDIA_ROOT volume, and how many instances run, is not defined in the repo. The pgvector extension is set up by a shell script only." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;dashed=1;fillColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;" vertex="1" parent="boundary"><mxGeometry x="40" y="560" width="280" height="140" as="geometry"></mxGeometry></mxCell>
<mxCell id="ext_smtp" value='&lt;b&gt;SMTP mail server&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Port 587, STARTTLS&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#e6e6e6;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1450" y="300" width="200" height="90" as="geometry"></mxGeometry></mxCell>
<mxCell id="ext_google" value='&lt;b&gt;Google OAuth 2.0&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External system]&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#e6e6e6;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1450" y="440" width="200" height="80" as="geometry"></mxGeometry></mxCell>
<mxCell id="ext_zoom" value='&lt;b&gt;Zoom API&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External system]&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#e6e6e6;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1450" y="570" width="200" height="80" as="geometry"></mxGeometry></mxCell>
<mxCell id="ext_openai" value='&lt;b&gt;OpenAI embeddings&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;management command only&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#e6e6e6;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1450" y="700" width="200" height="90" as="geometry"></mxGeometry></mxCell>
