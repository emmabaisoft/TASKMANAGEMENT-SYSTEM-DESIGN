<mxCell id="c_operator_api" value="HTTPS /admin (session)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryY=0.8;" edge="1" parent="1" source="actor_operator" target="con_api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
