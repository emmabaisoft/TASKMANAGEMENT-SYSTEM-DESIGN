<mxCell id="actor_user" value='&lt;b&gt;Institution user&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Employee, supervisor, administrator or institution owner. Works in the browser through the host platform.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="120" y="150" width="260" height="110" as="geometry"></mxGeometry></mxCell>
<mxCell id="actor_operator" value='&lt;b&gt;Platform operator&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Staff/superuser who uses the Django admin site.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="260" height="110" as="geometry"></mxGeometry></mxCell>
<mxCell id="actor_recipient" value='&lt;b&gt;External report recipient&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Not a system user. Receives scheduled report e-mails (reports.ExternalUser).&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="920" y="150" width="260" height="110" as="geometry"></mxGeometry></mxCell>
<mxCell id="sys_taskmgt" value='&lt;b&gt;Task &amp;amp; Performance Management&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Multi-tenant (per institution) projects, tasks, KPIs, performance reports, improvement plans, approvals, calendar, announcements and scheduled reports.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="470" y="420" width="360" height="170" as="geometry"></mxGeometry></mxCell>
<mxCell id="ext_partner" value='&lt;b&gt;Partner / host platform&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Registered as a PartnerSystem. Provisions institutions, users, resources and KPI configuration here; receives callbacks and notifications.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#e6e6e6;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="280" height="150" as="geometry"></mxGeometry></mxCell>
<mxCell id="ext_smtp" value='&lt;b&gt;SMTP mail server&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Outgoing e-mail (task, KPI, PIP, report and error e-mails).&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#e6e6e6;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="120" y="760" width="240" height="110" as="geometry"></mxGeometry></mxCell>
<mxCell id="ext_google" value='&lt;b&gt;Google OAuth 2.0&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Sign-in with Google (authorisation URL, token exchange, user info).&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#e6e6e6;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="760" width="240" height="110" as="geometry"></mxGeometry></mxCell>
<mxCell id="ext_zoom" value='&lt;b&gt;Zoom API&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;OAuth token helper on Institution; meeting creation helper exists but its call is commented out.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#e6e6e6;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="720" y="760" width="240" height="110" as="geometry"></mxGeometry></mxCell>
<mxCell id="ext_openai" value='&lt;b&gt;OpenAI embeddings&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Used only by the load_schema_embeddings management command.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#e6e6e6;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020" y="760" width="240" height="110" as="geometry"></mxGeometry></mxCell>
<mxCell id="ext_metrics" value='&lt;b&gt;Metrics scraper&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Prometheus-format metrics are exposed at /metrics.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=8;fillColor=#e6e6e6;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="980" y="440" width="240" height="110" as="geometry"></mxGeometry></mxCell>
