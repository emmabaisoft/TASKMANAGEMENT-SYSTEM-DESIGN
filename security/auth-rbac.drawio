<mxCell id="p_start" value="&lt;b&gt;Authenticated request reaches a DRF view&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="140" width="300" height="50" as="geometry"></mxGeometry></mxCell>
<mxCell id="p_default" value="permission_classes (default &lt;b&gt;IsAuthenticated&lt;/b&gt;; 21 API routes declare AllowAny)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="230" width="300" height="70" as="geometry"></mxGeometry></mxCell>
<mxCell id="p_mixin" value="View uses &lt;b&gt;MethodPermissionMixin&lt;/b&gt;?&lt;br&gt;(118 routes)" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="400" y="350" width="340" height="90" as="geometry"></mxGeometry></mxCell>
<mxCell id="p_inline" value="No mixin: the handler / service calls InstitutionPermission.require(...) or user.has_permission(...) itself, or performs no code-level check" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="840" y="360" width="320" height="80" as="geometry"></mxGeometry></mxCell>
<mxCell id="p_lookup" value="method_permissions[HTTP method]&lt;br&gt;(HEAD uses GET; OPTIONS unchecked)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="490" width="300" height="70" as="geometry"></mxGeometry></mxCell>
<mxCell id="p_missing" value="Method not declared → 403" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="260" height="50" as="geometry"></mxGeometry></mxCell>
<mxCell id="p_none" value="Value is None → no permission needed" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="840" y="500" width="320" height="50" as="geometry"></mxGeometry></mxCell>
<mxCell id="p_inst" value="Current institution on request?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="400" y="610" width="340" height="80" as="geometry"></mxGeometry></mxCell>
