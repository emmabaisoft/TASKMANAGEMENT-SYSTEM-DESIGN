<mxCell id="a_req" value="&lt;b&gt;Incoming HTTP request&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="260" height="50" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_mw" value="&lt;b&gt;ResourceMiddleware&lt;/b&gt;&lt;br&gt;path starts with /api/performance and is not in the 3 excluded paths?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="480" y="230" width="340" height="90" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_mw_hdr" value="Look up AppraisalResource by &lt;b&gt;X-Resource-UUID&lt;/b&gt; (cached 300 s) → request.current_resource" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="240" width="300" height="70" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_mw_bad" value="400 – header missing or resource invalid" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1280" y="250" width="240" height="50" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_key" value="&lt;b&gt;CrossSystemJWTAuthentication&lt;/b&gt;&lt;br&gt;X-API-Key header present?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="480" y="380" width="340" height="90" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_ps" value="PartnerSystem lookup by api_key (is_active)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="300" height="70" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_ps_bad" value="401 – invalid or inactive API key" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="300" height="50" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_ids" value="X-External-User-UUID &lt;b&gt;and&lt;/b&gt; X-Internal-User-UUID present?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="300" height="90" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_s2s" value="System-to-system call:&lt;br&gt;user = AnonymousUser, auth = PartnerSystem&lt;br&gt;request.is_system_to_system = True" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="300" height="80" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_ext" value="ExternalIdentity lookup (perac_base_uuid, base_uuid, partner_system, is_active)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="300" height="70" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_ext_bad" value="401 – invalid user ID" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="420" y="680" width="200" height="50" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_ext_inst" value="Second ExternalIdentity check (not deleted, institution active) → institution = identity.institution" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="800" width="320" height="80" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_ext_ok" value="user = identity.user, auth = PartnerSystem&lt;br&gt;request.institution set" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="940" width="320" height="70" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_jwt" value="SimpleJWT: validate &lt;b&gt;Authorization: Bearer&lt;/b&gt; access token (HS256, 1 h default; per-institution inactivity lifetime)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="390" width="300" height="80" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_jwt_none" value="No credentials → unauthenticated;&lt;br&gt;IsAuthenticated then returns 401" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1280" y="400" width="260" height="60" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_claim" value="Token has &lt;b&gt;current_institution&lt;/b&gt; claim?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="530" width="300" height="90" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_noinst" value="Authenticated without institution context (pre-selection token)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1280" y="545" width="260" height="60" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_member" value="Institution active &lt;b&gt;and&lt;/b&gt; (active ProfileInstitution membership &lt;b&gt;or&lt;/b&gt; user is institution owner)?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="680" width="340" height="100" as="geometry"></mxGeometry></mxCell>
<mxCell id="a_member_bad" value="401 – institution access no longer available / membership required" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1280" y="700" width="260" height="60" as="geometry"></mxGeometry></mxCell>
