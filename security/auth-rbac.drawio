<mxCell id="p_owner" value="User is institution_owner?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="400" y="740" width="340" height="80" as="geometry"></mxGeometry></mxCell>
<mxCell id="p_allow_owner" value="Allowed (owner bypass)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="840" y="755" width="320" height="50" as="geometry"></mxGeometry></mxCell>
<mxCell id="p_up" value="Any of the codes in UserPermission for (user, institution)?&lt;br&gt;deleted rows / deleted permissions excluded" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="400" y="870" width="340" height="100" as="geometry"></mxGeometry></mxCell>
<mxCell id="p_allow" value="Allowed → handler runs (tenant-scoped queries)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="840" y="895" width="320" height="50" as="geometry"></mxGeometry></mxCell>
<mxCell id="p_deny" value="403 – “You do not have permission to perform this action.”" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="895" width="260" height="50" as="geometry"></mxGeometry></mxCell>
