<mxCell id="note1" value="Every mark_* method requires status = pending and runs in one transaction. Approvers and overriders come from ApprovalDocumentLevel (approver groups: static users, roles, or dynamic by permission)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fffde7;strokeColor=#bfa900;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="240" y="800" width="520" height="110" as="geometry"></mxGeometry></mxCell>
<mxCell id="note2" value="approval/tasks.py defines send_overdue_approval_reminders, but it is not in the code-defined beat schedule (it may be registered in the django-celery-beat tables)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fffde7;strokeColor=#bfa900;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="820" y="800" width="420" height="110" as="geometry"></mxGeometry></mxCell>
