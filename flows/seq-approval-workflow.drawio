<mxCell id="n15" value="Models with has_custom_logic and no document get an auto-generated one-level document whose approvers are a dynamic ApproverGroup = users holding the model's FINAL_APPROVAL_PERMISSION." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fffde7;strokeColor=#bfa900;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1520" y="782" width="320" height="74" as="geometry"></mxGeometry></mxCell>
