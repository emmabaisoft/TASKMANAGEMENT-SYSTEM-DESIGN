<mxCell id="t1_init_scheduled" value="created with start_at in the future" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_init" target="s_scheduled"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t2_init_active" value="created with start_at reached&lt;br&gt;(manual, or automated from an attention record)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;" edge="1" parent="1" source="s_init" target="s_active"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t3_scheduled_active" value="activate_scheduled_pips()&lt;br&gt;hourly KPI processor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_scheduled" target="s_active"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t4_active_final_due" value="end_at passed and final review not completed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_active" target="s_final_due"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
